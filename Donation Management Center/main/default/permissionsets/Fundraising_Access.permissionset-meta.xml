    <!-- ── Tab visibility ────────────────────────────────────────────── -->
    <tabSettings>
        <tab>Dmc_Review_Manager</tab>
        <visibility>Visible</visibility>
    </tabSettings>
    <tabSettings>
        <tab>Zeffy_Review_Ticket__c</tab>
        <visibility>Available</visibility>
    </tabSettings>

    <!-- ── Apex class access ──────────────────────────────────────────── -->
    <classAccesses>
        <apexClass>DmcConfigService</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>DmcDonationService</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>DmcLapsedDonorBatch</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>DmcWebhookReceiver</apexClass>
        <enabled>true</enabled>
    </classAccesses>
</PermissionSet>
