<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>64.0</apiVersion>
    <description>Cuando hed__Deceased__c cambia a true: activa Mail_Opt_Out__c, Excl__c y pone Excl_date__c. Cuando cambia a false y Excl_reason__c está vacío: revierte los tres campos.</description>
    <environments>Default</environments>
    <interviewLabel>Contact - Deceased Sync Opt Out {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Contact - Deceased Sync Opt Out</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>

    <!-- Variable nula de tipo Date para limpiar Excl_date__c -->
    <variables>
        <name>nullDate</name>
        <dataType>Date</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>

    <start>
        <locationX>56</locationX>
        <locationY>0</locationY>
        <!-- Corre si: (Deceased=true Y Mail_Opt_Out=false) O (Deceased=false Y Excl=true Y Excl_reason vacío) -->
        <filterLogic>(1 AND 2) OR (3 AND 4 AND 5)</filterLogic>
        <filters>
            <field>hed__Deceased__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Mail_Opt_Out__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>hed__Deceased__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Excl__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Excl_reason__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>Contact</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
        <connector>
            <targetReference>Check_Deceased_Direction</targetReference>
        </connector>
    </start>
    <status>Active</status>

    <decisions>
        <name>Check_Deceased_Direction</name>
        <label>Deceased activado o desactivado?</label>
        <locationX>56</locationX>
        <locationY>120</locationY>
        <defaultConnectorLabel>Desactivado — Limpiar campos</defaultConnectorLabel>
        <defaultConnector>
            <targetReference>Clear_Opt_Out_Fields</targetReference>
        </defaultConnector>
        <rules>
            <name>Deceased_Activado</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.hed__Deceased__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Opt_Out_Fields</targetReference>
            </connector>
            <label>Activado — Poner campos</label>
        </rules>
    </decisions>

    <recordUpdates>
        <name>Set_Opt_Out_Fields</name>
        <label>Set Mail Opt Out, Excl y Fecha</label>
        <locationX>56</locationX>
        <locationY>240</locationY>
        <inputAssignments>
            <field>Mail_Opt_Out__c</field>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Excl__c</field>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Excl_date__c</field>
            <value>
                <elementReference>$Flow.CurrentDate</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>

    <recordUpdates>
        <name>Clear_Opt_Out_Fields</name>
        <label>Limpiar Mail Opt Out, Excl y Fecha</label>
        <locationX>264</locationX>
        <locationY>240</locationY>
        <inputAssignments>
            <field>Mail_Opt_Out__c</field>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Excl__c</field>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Excl_date__c</field>
            <value>
                <elementReference>nullDate</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>

</Flow>
