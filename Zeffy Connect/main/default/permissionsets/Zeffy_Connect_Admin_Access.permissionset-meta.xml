<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>Add-on for Zeffy Connect administrators. Unlocks the Credentials tab in Settings (API Key and Webhook Secret). Assign in addition to Zeffy Connect Access — never on its own.</description>
    <hasActivationRequired>false</hasActivationRequired>
    <label>Zeffy Connect Admin Access</label>

    <!-- Unlocks the Credentials nav tab in the Settings panel -->
    <customPermissions>
        <enabled>true</enabled>
        <name>Zeffy_Connect_Settings_Access</name>
    </customPermissions>

    <!-- Zeffy_Config__c — credential fields (edit access for admins) -->
    <fieldPermissions><editable>true</editable><field>Zeffy_Config__c.Process_Contact_Events__c</field><readable>true</readable></fieldPermissions>
    <fieldPermissions><editable>true</editable><field>Zeffy_Config__c.Process_Payment_Created__c</field><readable>true</readable></fieldPermissions>
    <fieldPermissions><editable>true</editable><field>Zeffy_Config__c.Process_Payment_Deleted__c</field><readable>true</readable></fieldPermissions>
    <fieldPermissions><editable>true</editable><field>Zeffy_Config__c.Process_Payment_Updated__c</field><readable>true</readable></fieldPermissions>
    <fieldPermissions><editable>true</editable><field>Zeffy_Webhook_Log__c.Raw_Payload__c</field><readable>true</readable></fieldPermissions>
    <fieldPermissions><editable>true</editable><field>Zeffy_Webhook_Log__c.Has_Raw_Payload__c</field><readable>true</readable></fieldPermissions>
    <fieldPermissions><editable>true</editable><field>Zeffy_Config__c.API_Key__c</field><readable>true</readable></fieldPermissions>
    <fieldPermissions><editable>true</editable><field>Zeffy_Config__c.Show_Followup_Button__c</field><readable>true</readable></fieldPermissions>
    <fieldPermissions><editable>true</editable><field>Zeffy_Config__c.Holding_Expire_Disabled_At__c</field><readable>true</readable></fieldPermissions>
    <fieldPermissions><editable>true</editable><field>Zeffy_Config__c.Is_Active__c</field><readable>true</readable></fieldPermissions>
    <fieldPermissions><editable>true</editable><field>Zeffy_Config__c.Webhook_Secret__c</field><readable>true</readable></fieldPermissions>
    <fieldPermissions><editable>true</editable><field>Zeffy_Config__c.Webhook_Endpoint_Url__c</field><readable>true</readable></fieldPermissions>

    <!-- Zeffy_Config__c — object write access needed to save credentials -->
    <objectPermissions>
        <allowCreate>false</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>true</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>Zeffy_Webhook_Log__c</object>
        <viewAllRecords>true</viewAllRecords>
    </objectPermissions>
    <objectPermissions>
        <allowCreate>true</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>true</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>Zeffy_Config__c</object>
        <viewAllRecords>true</viewAllRecords>
    </objectPermissions>

    <!-- Apex class access — saveConfig (credentials) -->
    <classAccesses>
        <apexClass>ZeffyConnectConfigService</apexClass>
        <enabled>true</enabled>
    </classAccesses>
</PermissionSet>
