<?xml version="1.0" encoding="UTF-8"?>
<!-- DRAFT — Inactive. Activate when receiving donations directly in Salesforce (not via Zeffy).
     Configure: add email template + Send Email action in Flow Builder. -->
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>64.0</apiVersion>
    <description>Sends a thank-you acknowledgement email when a Gift Transaction is created with Status = Received. DRAFT — activate when not using Zeffy for acknowledgements.</description>
    <interviewLabel>Gift Acknowledgement {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Gift Acknowledgement</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <status>Draft</status>
    <start>
        <locationX>56</locationX>
        <locationY>0</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Received</stringValue>
            </value>
        </filters>
        <object>Gift_Transaction__c</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
</Flow>
