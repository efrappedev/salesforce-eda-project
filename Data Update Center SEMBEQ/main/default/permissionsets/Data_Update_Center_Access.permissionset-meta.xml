<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>Grants access to the Data Update Center (Data_Update_Request__c object and its inbox) including explicit FLS for all fields — without this, non-required fields do not appear in the describe/review UI even if the deploy reports Succeeded.</description>
    <hasActivationRequired>false</hasActivationRequired>
    <label>Data Update Center Access</label>
    <!-- Without this, non-admin staff only see the Data_Update_Center tab under "All Items" —
         the app itself was visible only via the Admin profile. -->
    <applicationVisibilities>
        <application>Data_Update_Center</application>
        <visible>true</visible>
    </applicationVisibilities>
    <classAccesses>
        <apexClass>DataUpdatePortalController</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>DataUpdateReviewController</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>DataUpdateFormAdminController</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>DataUpdateFormAdminMetadataDeleteService</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <!-- DataUpdate_MetadataApi_NC / DataUpdate_MetadataApi_Cred (Named Credential + External
         Credential, OAuth 2.0 Client Credentials Flow) are no longer used — the hard-delete flow
         (see DataUpdateFormAdminMetadataDeleteService) now authenticates with the logged-in
         admin's own session ID instead, since Client Credentials Flow tokens don't create a
         session the legacy SOAP Metadata API recognizes (confirmed rondas 103/104). That old
         infra can be decommissioned in Setup whenever convenient. -->
    <customMetadataTypeAccesses>
        <enabled>true</enabled>
        <name>Data_Update_Appearance_Template__mdt</name>
    </customMetadataTypeAccesses>
    <customMetadataTypeAccesses>
        <enabled>true</enabled>
        <name>Data_Update_Form__mdt</name>
    </customMetadataTypeAccesses>
    <customMetadataTypeAccesses>
        <enabled>true</enabled>
        <name>Data_Update_Form_Field__mdt</name>
    </customMetadataTypeAccesses>
    <objectPermissions>
        <allowCreate>false</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>false</allowEdit>
        <allowRead>false</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>DUC_Form_Config__c</object>
        <viewAllRecords>false</viewAllRecords>
    </objectPermissions>
    <objectPermissions>
        <allowCreate>true</allowCreate>
        <allowDelete>true</allowDelete>
        <allowEdit>true</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>Data_Update_Presence__c</object>
        <viewAllRecords>false</viewAllRecords>
    </objectPermissions>
    <objectPermissions>
        <allowCreate>true</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>false</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>Data_Update_Request__c</object>
        <viewAllRecords>true</viewAllRecords>
    </objectPermissions>
    <objectPermissions>
        <allowCreate>true</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>false</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
